# Demo request form (Resend) — copy to .env.local and fill in.

# Public canonical site URL used for metadata, sitemap, and Open Graph.
NEXT_PUBLIC_SITE_URL=https://enterprise.powerhouse.io

# Resend API key — create at https://resend.com/api-keys
RESEND_API_KEY=

# Where demo-request leads are delivered (defaults to hello@powerhouse.inc)
DEMO_LEADS_TO=hello@powerhouse.inc

# Verified "from" sender. The domain must be verified in Resend.
# For local testing you can use: Powerhouse <onboarding@resend.dev>
DEMO_LEADS_FROM=Powerhouse <demo@powerhouse.inc>
